cat > .gitignore <<'EOF'
# PlatformIO
.pio/

# VS Code generated/local files
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch/

# Temporary/editor files
*.orig
*.rej
*.bak
*.tmp

# Patch files
*.patch

# OS files
.DS_Store
Thumbs.db
EOF

# Project export archives
*.zip